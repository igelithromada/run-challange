rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && (
          request.auth.token.admin == true
          || (
            exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin"
          )
        );
    }

    match /users/{userId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow create: if signedIn()
        && request.auth.uid == userId
        && !request.resource.data.keys().hasAny(["role", "blocked"]);

      // Users may edit their own profile/preferences, but never elevate themselves
      // or change moderation/account-control fields.
      allow update: if isAdmin()
        || (signedIn()
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              "nickname",
              "avatarUrl",
              "avatarPublicId",
              "theme",
              "customColor",
              "gradientEnabled",
              "themeUpdatedAt",
              "hapticsEnabled",
              "defaultActivity",
              "confirmDelete",
              "progressGoals",
              "progressGoalsByType",
              "personalTrainerPlan",
              "personalTrainerPlans",
              "personalTrainerHistory",
              "trainerNotifications"
            ]));

      allow delete: if isAdmin();
    }

    match /publicProfiles/{userId} {
      allow read: if signedIn();
      allow create: if isAdmin()
        || (signedIn()
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(["nickname", "avatarUrl", "activityType"]));
      allow update: if isAdmin()
        || (signedIn()
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["nickname", "avatarUrl", "activityType"]));
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == userId);
    }

    match /runs/{runId} {
      allow read: if signedIn();

      // Aktivity zapisuje a mění pouze server, protože zápis současně
      // aktualizuje týmové statistiky a výsledky výzev.
      allow create: if false;

      // Vlastník může upravovat pouze skutečně editovatelná pole aktivity.
      // Sociální počítadla, autora, vlastníka a tým spravuje aplikace/server.
      allow update: if isAdmin();

      allow delete: if isAdmin();
    }

    match /teams/{teamId} {
      allow read: if signedIn();
      allow create, update, delete: if false;
    }

    match /teams/{teamId}/members/{memberId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /teamNames/{nameKey} {
      allow read, write: if false;
    }

    match /challenges/{challengeId} {
      allow read: if signedIn();
      allow create, update, delete: if false;
    }

    match /challenges/{challengeId}/participants/{participantId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /challengeNames/{nameKey} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
