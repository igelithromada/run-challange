{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "schedules": {
    "trainer-hourly": {
      "schedule": "0 * * * *",
      "path": "/api/notifications/trainer",
      "timezone": "Europe/Prague",
      "requestMethod": "GET"
    },
    "challenges-hourly": {
      "schedule": "5 * * * *",
      "path": "/api/challenges/lifecycle",
      "timezone": "Europe/Prague",
      "requestMethod": "GET"
    }
  }
}
